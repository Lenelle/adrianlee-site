---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Adrian Lee"
  description="Community Ecosystem Strategist, AI Governance Professional, and Platform Safety expert. Building communities that matter and the governance systems to sustain them."
>

  <!-- HERO -->
  <section class="hero" aria-label="Hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <div class="hero__eyebrow animate-fade-up">
          <div class="status-pill">
            <span class="dot" aria-hidden="true"></span>
            Open to advisory engagements · Based in Singapore
          </div>
        </div>

        <h1 class="hero__name animate-fade-up delay-1">
          Adrian<br><em>Lee</em>
        </h1>

        <div class="hero__roles animate-fade-up delay-2">
          <span>Community Ecosystems</span>
          <span class="dot-sep" aria-hidden="true">·</span>
          <span>AI Governance</span>
          <span class="dot-sep" aria-hidden="true">·</span>
          <span>Platform Safety</span>
        </div>

        <p class="hero__desc animate-fade-up delay-3">
          I build communities that actually work — and the governance systems to keep them safe, 
          ethical, and resilient. Certified AI Governance Professional with experience across gaming, 
          fintech, and consumer tech at global scale.
        </p>

        <div class="hero__creds animate-fade-up delay-4">
          <span class="label">Past &amp; present</span>
          <div class="hero__orgs">
            <span>SPF</span>
            <span>IAHGames</span>
            <span>Google</span>
            <span>Wargaming</span>
            <span>Binance</span>
            <span>OKX</span>
          </div>
        </div>

        <div class="hero__actions animate-fade-up delay-5">
          <a href="/playbook" class="btn btn-primary btn-lg" id="hero-cta-playbook">
            Explore the Playbook
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/services" class="btn btn-outline btn-lg" id="hero-cta-services">Work With Me</a>
        </div>
      </div>

      <div class="hero__photo-wrap animate-fade delay-2">
        <div class="hero__photo-frame">
          <img
            src="/images/adrian-lee.jpg"
            alt="Adrian Lee — Community Strategist and AI Governance Professional"
            class="hero__photo"
            width="480"
            height="600"
            loading="eager"
          />
          <div class="hero__photo-badge">
            <span>CAIGP</span>
            <span>Certified</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- AUDIENCE TRIAGE -->
  <section class="triage section--sm" aria-labelledby="triage-heading">
    <div class="container">
      <div class="section-label"><span class="label">How can I help you?</span></div>
      <h2 id="triage-heading" class="triage__title">Find what you need</h2>

      <div class="triage__grid">
        <a href="/services" class="triage__card triage__card--1 card card--clickable" id="triage-services">
          <div class="triage__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <h3>Founders &amp; Execs</h3>
          <p>Community strategy, audits, 0-to-1 architecture, and advisory retainers for scaling teams.</p>
          <span class="triage__link">View Services →</span>
        </a>

        <a href="/ai-governance" class="triage__card triage__card--2 card card--clickable card--ai" id="triage-governance">
          <div class="triage__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h3>Think Tanks &amp; Orgs</h3>
          <p>AI governance research, ethics frameworks, participatory red-teaming, and keynotes.</p>
          <span class="triage__link">AI Governance →</span>
        </a>

        <a href="/playbook" class="triage__card triage__card--3 card card--clickable card--community" id="triage-playbook">
          <div class="triage__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
          </div>
          <h3>Community Builders</h3>
          <p>Open playbooks, battle-tested frameworks, templates, and tactical how-to guides.</p>
          <span class="triage__link">Browse Playbook →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FEATURED CONTENT -->
  <section class="featured section" aria-labelledby="featured-heading">
    <div class="container">
      <div class="featured__header">
        <div>
          <div class="section-label"><span class="label">Latest thinking</span></div>
          <h2 id="featured-heading">From the Playbook &amp; AI Governance</h2>
        </div>
        <div class="featured__all-links">
          <a href="/playbook" class="btn btn-ghost btn-sm">All Playbook →</a>
          <a href="/ai-governance" class="btn btn-ghost btn-sm">All AI Gov →</a>
        </div>
      </div>

      <div class="featured__grid">
        <a href="/playbook/agentic-ai-resilience-playbook" class="featured__card card card--clickable card--ai featured__card--hero" id="featured-agentic-resilience" style="grid-column: 1 / -1;">
          <div class="featured__meta">
            <span class="badge badge--ai">Flagship Playbook</span>
            <span class="badge badge--community">Community Safety</span>
            <span class="maturity maturity--evergreen">🌲 Evergreen · v1.0</span>
          </div>
          <h3 style="font-size: 1.5rem;">Agentic AI Social &amp; Customer Service Resilience Playbook</h3>
          <p style="font-size: 1.05rem; max-width: 820px;">
            Defending AI agents against inference abuse, context pollution, tool amplification, and human-escalation exhaustion. 
            The comprehensive 14-section framework uniting AI governance, economic throttling, and community platform safety.
          </p>
          <div class="featured__footer">
            <span class="read-time" style="font-weight: 600; color: var(--terracotta);">25 min comprehensive reference</span>
            <span class="featured__arrow" style="font-size: 1.25rem;">Read the Flagship Playbook →</span>
          </div>
        </a>

        <a href="/playbook/community-onboarding-playbook" class="featured__card card card--clickable card--community" id="featured-onboarding">
          <div class="featured__meta">
            <span class="badge badge--community">Community</span>
            <span class="maturity maturity--evergreen">🌲 Evergreen</span>
          </div>
          <h3>The Community Onboarding Playbook</h3>
          <p>A step-by-step framework for welcoming new members in ways that create long-term belonging.</p>
          <div class="featured__footer">
            <span class="read-time">8 min read</span>
            <span class="featured__arrow">→</span>
          </div>
        </a>

        <a href="/playbook/moderation-at-scale" class="featured__card card card--clickable card--community" id="featured-moderation">
          <div class="featured__meta">
            <span class="badge badge--community">Community</span>
            <span class="maturity maturity--budding">🌿 Budding</span>
          </div>
          <h3>Moderation at Scale: What Global Platforms Get Wrong</h3>
          <p>Lessons from moderating communities of millions — and the human systems required to make it humane.</p>
          <div class="featured__footer">
            <span class="read-time">12 min read</span>
            <span class="featured__arrow">→</span>
          </div>
        </a>

        <a href="/ai-governance/participatory-red-teaming" class="featured__card card card--clickable card--ai" id="featured-redteaming">
          <div class="featured__meta">
            <span class="badge badge--ai">AI Governance</span>
            <span class="maturity maturity--budding">🌿 Budding</span>
          </div>
          <h3>Participatory Red-Teaming: Community as a Safety Mechanism</h3>
          <p>How involving community members in adversarial AI testing produces safer outcomes.</p>
          <div class="featured__footer">
            <span class="read-time">10 min read</span>
            <span class="featured__arrow">→</span>
          </div>
        </a>

        <a href="/ai-governance/caigp-certification" class="featured__card card card--clickable card--ai" id="featured-caigp">
          <div class="featured__meta">
            <span class="badge badge--ai">AI Governance</span>
            <span class="maturity maturity--evergreen">🌲 Evergreen</span>
          </div>
          <h3>What the CAIGP Certification Actually Covers</h3>
          <p>A practitioner's honest breakdown of the Certified AI Governance Professional curriculum.</p>
          <div class="featured__footer">
            <span class="read-time">6 min read</span>
            <span class="featured__arrow">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="philosophy section--sm" aria-labelledby="philosophy-heading">
    <div class="container">
      <div class="philosophy__inner">
        <div class="philosophy__text">
          <div class="section-label"><span class="label">The belief behind the work</span></div>
          <h2 id="philosophy-heading">
            Technology is only as trustworthy as the<br>
            <em>human systems governing it.</em>
          </h2>
          <p>
            I've spent a decade building and governing communities across gaming, crypto, 
            consumer tech, and civic spaces. Every platform safety crisis, every community 
            collapse, every governance failure traces back to a breakdown in how humans 
            relate to one another inside systems.
          </p>
          <p>
            That's why I work at the intersection of community architecture and AI governance. 
            One without the other is incomplete.
          </p>
          <a href="/about" class="btn btn-outline" id="philosophy-about-cta" style="margin-top:1.5rem; display:inline-flex;">
            Read my story →
          </a>
        </div>
        <div class="philosophy__portrait">
          <img
            src="/images/adrian-lee.jpg"
            alt="Adrian Lee"
            width="340"
            height="420"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* HERO */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-top: var(--nav-h);
  padding-bottom: var(--space-16);
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  top: -200px; right: -200px;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(194,94,62,0.07) 0%, transparent 70%);
  pointer-events: none;
}
.hero__inner {
  display: grid;
  grid-template-columns: 1fr 420px;
  gap: var(--space-16);
  align-items: center;
  width: 100%;
}
.hero__eyebrow { margin-bottom: var(--space-6); }
.hero__name {
  font-size: clamp(3.5rem, 8vw, 6.5rem);
  line-height: 1.0;
  font-weight: 300;
  letter-spacing: -0.03em;
  margin-bottom: var(--space-5);
}
.hero__name em { color: var(--terracotta); }
.hero__roles {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-6);
  font-size: 0.875rem;
  color: var(--text-muted);
  font-weight: 500;
}
.dot-sep { color: var(--border-soft); }
.hero__desc {
  font-size: 1.125rem;
  color: var(--text-muted);
  max-width: 520px;
  line-height: 1.75;
  margin-bottom: var(--space-6);
}
.hero__creds { margin-bottom: var(--space-8); }
.hero__creds .label { margin-bottom: var(--space-3); display: block; }
.hero__orgs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.hero__orgs span {
  padding: 0.25rem 0.75rem;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.05em;
  font-family: var(--font-mono);
}
.hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
.hero__photo-wrap { display: flex; justify-content: flex-end; }
.hero__photo-frame {
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  width: 100%;
  max-width: 420px;
  border: 1px solid var(--border-soft);
}
.hero__photo {
  width: 100%;
  height: 540px;
  object-fit: cover;
  object-position: center top;
  filter: brightness(0.92) contrast(1.04);
}
.hero__photo-badge {
  position: absolute;
  bottom: var(--space-4);
  right: var(--space-4);
  background: rgba(23,21,19,0.88);
  backdrop-filter: blur(8px);
  border: 1px solid var(--border-soft);
  border-radius: var(--radius-md);
  padding: 0.4rem 0.85rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.2;
}
.hero__photo-badge span:first-child {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--ochre);
  letter-spacing: 0.08em;
  font-family: var(--font-mono);
}
.hero__photo-badge span:last-child {
  font-size: 0.65rem;
  color: var(--text-muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
@media (max-width: 1024px) {
  .hero__inner { grid-template-columns: 1fr 340px; gap: var(--space-10); }
}
@media (max-width: 768px) {
  .hero__inner { grid-template-columns: 1fr; }
  .hero__photo-wrap { order: -1; justify-content: center; }
  .hero__photo-frame { max-width: 300px; }
  .hero__photo { height: 380px; }
}

/* TRIAGE */
.triage__title { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: var(--space-8); }
.triage__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
.triage__card { padding: var(--space-8); text-decoration: none; color: inherit; }
.triage__icon {
  width: 52px; height: 52px;
  background: var(--bg-elevated);
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--space-5);
  color: var(--text-muted);
  transition: all var(--transition-normal);
}
.triage__card:hover .triage__icon { color: var(--terracotta); }
.triage__card--2:hover .triage__icon { color: var(--ochre); }
.triage__card--3:hover .triage__icon { color: var(--sage-light); }
.triage__card h3 { font-size: 1.25rem; margin-bottom: var(--space-3); }
.triage__card p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.65; margin-bottom: var(--space-5); }
.triage__link { font-size: 0.875rem; font-weight: 600; color: var(--terracotta); }
.triage__card--2 .triage__link { color: var(--ochre); }
.triage__card--3 .triage__link { color: var(--sage-light); }
@media (max-width: 768px) { .triage__grid { grid-template-columns: 1fr; } }
@media (min-width: 769px) and (max-width: 1024px) {
  .triage__grid { grid-template-columns: 1fr 1fr; }
}

/* FEATURED */
.featured__header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--space-8); gap: var(--space-4); }
.featured__header h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
.featured__all-links { display: flex; gap: var(--space-2); flex-shrink: 0; }
.featured__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5); }
.featured__card { padding: var(--space-7); text-decoration: none; color: inherit; }
.featured__meta { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); }
.featured__card h3 { font-size: 1.15rem; margin-bottom: var(--space-3); line-height: 1.35; }
.featured__card p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.65; margin-bottom: var(--space-5); }
.featured__footer { display: flex; justify-content: space-between; align-items: center; }
.featured__arrow { color: var(--text-faint); transition: color var(--transition-fast), transform var(--transition-fast); }
.featured__card:hover .featured__arrow { color: var(--terracotta); transform: translateX(4px); }
@media (max-width: 768px) {
  .featured__grid { grid-template-columns: 1fr; }
  .featured__header { flex-direction: column; align-items: flex-start; }
}

/* PHILOSOPHY */
.philosophy { background: var(--bg-surface); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
.philosophy__inner { display: grid; grid-template-columns: 1fr 300px; gap: var(--space-16); align-items: center; }
.philosophy__text h2 { font-size: clamp(1.75rem, 3.5vw, 2.5rem); margin-bottom: var(--space-6); line-height: 1.25; }
.philosophy__text h2 em { color: var(--terracotta); }
.philosophy__text p { color: var(--text-muted); margin-bottom: var(--space-4); }
.philosophy__portrait { border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--border-soft); }
.philosophy__portrait img { width: 100%; height: 360px; object-fit: cover; object-position: center top; filter: brightness(0.88) saturate(0.9); }
@media (max-width: 768px) {
  .philosophy__inner { grid-template-columns: 1fr; }
  .philosophy__portrait { display: none; }
}
</style>
