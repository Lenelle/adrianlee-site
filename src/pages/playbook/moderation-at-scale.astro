<ArticleLayout
  title="Moderation at Scale: What Global Platforms Get Wrong"
  description="Lessons from moderating communities of millions, and the operational systems needed to protect both the community and the moderation team."
  date="2025-06"
  maturity="budding"
  readTime="12 min"
