---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services"
  description="Community strategy, AI governance advisory, and speaking engagements. Work with Adrian Lee to build healthier, more resilient communities and AI governance programs."
>

  <div class="services-page" style="padding-top: var(--nav-h);">
    <div class="page-header">
      <div class="container">
        <div class="section-label"><span class="label">Services</span></div>
        <h1 class="page-header__title">
          What I can<br>
          <em>do for you.</em>
        </h1>
        <p class="page-header__desc">
          Practical, outcome-focused advisory across community strategy, platform safety, 
          and AI governance. No fluff — only work that moves the needle.
        </p>
      </div>
    </div>

    <!-- SERVICE CARDS -->
    <section class="services section" aria-labelledby="services-heading">
      <div class="container">
        <h2 class="sr-only" id="services-heading">Service offerings</h2>

        <!-- Service 1: Community Strategy -->
        <div class="service__block" id="service-community">
          <div class="service__label-col">
            <div class="section-label"><span class="label">01</span></div>
            <span class="badge badge--community">Community</span>
          </div>
          <div class="service__content">
            <h2>Community Strategy &amp; Advisory</h2>
            <p class="service__lead">
              For founders, product leaders, and executives who need to build — or fix — 
              a community that actually works.
            </p>
            <div class="service__offerings">
              <div class="service__offering">
                <h3>Community Diagnostic Audit</h3>
                <p>A structured review of your existing community's health: engagement depth, moderation gaps, structural risks, and untapped growth levers. Delivered as an actionable report.</p>
              </div>
              <div class="service__offering">
                <h3>0-to-1 Community Architecture</h3>
                <p>Building a community from scratch the right way — charter, member journey, onboarding rituals, tech stack selection, moderation philosophy, and the metrics that actually matter.</p>
              </div>
              <div class="service__offering">
                <h3>Advisory Retainer</h3>
                <p>Ongoing strategic advisory for community leads and their teams. Regular syncs, async review, and direct access to frameworks refined across gaming, crypto, and consumer tech.</p>
              </div>
            </div>
            <div class="service__who">
              <span class="label">Best for</span>
              <p>Early-stage startups building their first community, scaling companies whose community has grown faster than their governance, and product teams preparing a community launch.</p>
            </div>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Service 2: AI Governance -->
        <div class="service__block" id="service-ai">
          <div class="service__label-col">
            <div class="section-label"><span class="label">02</span></div>
            <span class="badge badge--ai">AI Governance</span>
          </div>
          <div class="service__content">
            <h2>AI Governance &amp; Ethics Consulting</h2>
            <p class="service__lead">
              For think tanks, policy organizations, and tech companies that need 
              practitioner-level AI governance expertise.
            </p>
            <div class="service__offerings">
              <div class="service__offering">
                <h3>Governance Framework Design</h3>
                <p>Designing AI governance programs that are actually implementable — risk assessment matrices, stakeholder participation models, red-teaming protocols, and accountability structures.</p>
              </div>
              <div class="service__offering">
                <h3>Participatory AI Assessment</h3>
                <p>Designing and facilitating community-based AI evaluation processes. Drawing on community architecture expertise to build participatory red-teaming and feedback programs.</p>
              </div>
              <div class="service__offering">
                <h3>Research &amp; Policy Advisory</h3>
                <p>Contributing practitioner perspectives to AI governance research, policy consultations, and white papers. Available for academic collaboration and think tank engagements.</p>
              </div>
            </div>
            <div class="service__who">
              <span class="label">Best for</span>
              <p>AI policy think tanks, ethics boards, government agencies, and technology companies seeking practitioner expertise to complement theoretical AI governance frameworks.</p>
            </div>
          </div>
        </div>

        <div class="divider"></div>

        <!-- Service 3: Speaking -->
        <div class="service__block" id="service-speaking">
          <div class="service__label-col">
            <div class="section-label"><span class="label">03</span></div>
            <span class="badge badge--terracotta">Speaking</span>
          </div>
          <div class="service__content">
            <h2>Speaking &amp; Workshops</h2>
            <p class="service__lead">
              Keynotes and workshops that bridge community design and AI governance 
              for conferences, company offsites, and training programs.
            </p>
            <div class="service__offerings">
              <div class="service__offering">
                <h3>Keynotes</h3>
                <p>Engaging, practitioner-grounded keynotes on community strategy, platform safety, and AI governance. Tailored to your audience from executive teams to conference crowds.</p>
              </div>
              <div class="service__offering">
                <h3>Workshops &amp; Training</h3>
                <p>Half-day and full-day workshops for community teams and trust &amp; safety practitioners. Hands-on, framework-driven, and immediately applicable.</p>
              </div>
            </div>
            <div class="service__who">
              <span class="label">Best for</span>
              <p>Tech conferences, community practitioner events, internal company training, AI ethics workshops, and policy convenings.</p>
            </div>
            <a href="/speaking" class="btn btn-outline btn-sm" style="margin-top: var(--space-5); display: inline-flex;" id="services-speaking-link">View speaking topics →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process section--sm" aria-labelledby="process-heading">
      <div class="container">
        <div class="section-label"><span class="label">How I work</span></div>
        <h2 id="process-heading">The engagement process</h2>

        <div class="process__steps">
          <div class="process__step">
            <div class="process__num">1</div>
            <h3>Discovery call</h3>
            <p>30 minutes. You share the context, I ask hard questions. We both figure out whether this is a fit.</p>
          </div>
          <div class="process__step">
            <div class="process__num">2</div>
            <h3>Scoping &amp; proposal</h3>
            <p>A clear proposal with scope, timeline, and pricing. No surprises.</p>
          </div>
          <div class="process__step">
            <div class="process__num">3</div>
            <h3>Deep work</h3>
            <p>Research, frameworks, workshops, or advisory — depending on what we agreed. Structured checkpoints throughout.</p>
          </div>
          <div class="process__step">
            <div class="process__num">4</div>
            <h3>Delivery &amp; handoff</h3>
            <p>Clear deliverables, documentation you can actually use, and a handoff that sets your team up to run independently.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="services-cta section--sm" aria-labelledby="services-cta-heading">
      <div class="container">
        <div class="card card--featured services-cta__card">
          <h2 id="services-cta-heading">Let's figure out if we're a fit</h2>
          <p>
            I work with a small number of clients at a time to keep the quality high. 
            If you're not sure whether I can help, the best place to start is a quick call.
          </p>
          <a href="/contact" class="btn btn-primary btn-lg" id="services-contact-cta">Start the conversation →</a>
          <p class="services-cta__note">Usually responds within 48 hours.</p>
        </div>
      </div>
    </section>
  </div>

</BaseLayout>

<style>
/* SERVICES LAYOUT */
.service__block {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: var(--space-12);
  padding-block: var(--space-6);
}
.service__label-col {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding-top: var(--space-2);
}
.service__content h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: var(--space-4); }
.service__lead { font-size: 1.125rem; color: var(--text-muted); margin-bottom: var(--space-8); max-width: 600px; line-height: 1.7; }
.service__offerings { display: flex; flex-direction: column; gap: var(--space-6); margin-bottom: var(--space-8); }
.service__offering {
  border-left: 2px solid var(--border-soft);
  padding-left: var(--space-6);
  transition: border-color var(--transition-fast);
}
.service__offering:hover { border-color: var(--terracotta); }
.service__offering h3 { font-size: 1.1rem; margin-bottom: var(--space-2); }
.service__offering p { color: var(--text-muted); font-size: 0.9375rem; }
.service__who { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-5) var(--space-6); }
.service__who .label { display: block; margin-bottom: var(--space-2); }
.service__who p { font-size: 0.9375rem; color: var(--text-muted); }

@media (max-width: 768px) {
  .service__block { grid-template-columns: 1fr; gap: var(--space-6); }
}

/* PROCESS */
.process h2 { margin-bottom: var(--space-10); }
.process__steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-6);
  position: relative;
}
.process__steps::before {
  content: '';
  position: absolute;
  top: 28px;
  left: 28px; right: 28px;
  height: 1px;
  background: var(--border-soft);
  z-index: 0;
}
.process__step { position: relative; z-index: 1; }
.process__num {
  width: 56px; height: 56px;
  border-radius: 50%;
  background: var(--bg-elevated);
  border: 1px solid var(--border-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 400;
  color: var(--text-muted);
  margin-bottom: var(--space-5);
  transition: all var(--transition-normal);
}
.process__step:hover .process__num { border-color: var(--terracotta); color: var(--terracotta); background: var(--terracotta-glow); }
.process__step h3 { font-size: 1.05rem; margin-bottom: var(--space-2); }
.process__step p { font-size: 0.9rem; color: var(--text-muted); line-height: 1.65; }
@media (max-width: 768px) {
  .process__steps { grid-template-columns: 1fr; }
  .process__steps::before { display: none; }
}
@media (min-width: 769px) and (max-width: 900px) {
  .process__steps { grid-template-columns: repeat(2, 1fr); }
  .process__steps::before { display: none; }
}

/* SERVICES CTA */
.services-cta__card { padding: var(--space-12); text-align: center; }
.services-cta__card h2 { margin-bottom: var(--space-4); }
.services-cta__card > p { color: var(--text-muted); max-width: 480px; margin-inline: auto; margin-bottom: var(--space-8); }
.services-cta__note { font-size: 0.8125rem; color: var(--text-faint); margin-top: var(--space-4); }
</style>
