---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Adrian Lee for community strategy advisory, AI governance consulting, or speaking engagements."
>
  <div class="contact-page" style="padding-top: var(--nav-h);">
    <div class="page-header">
      <div class="container">
        <div class="section-label"><span class="label">Contact</span></div>
        <h1 class="page-header__title">
          Let's see if<br>
          <em>we are a fit.</em>
        </h1>
        <p class="page-header__desc">
          I work with a small number of clients and collaborators at a time. 
          Tell me what you are working on. If I can help, I will say so directly. 
          If I am not the right person, I will point you in a better direction.
        </p>
      </div>
    </div>

    <section class="contact-main section" aria-labelledby="contact-form-heading">
      <div class="container">
        <div class="contact__grid">

          <!-- FORM -->
          <div class="contact__form-col">
            <h2 id="contact-form-heading" class="sr-only">Contact form</h2>
            <form
              class="contact__form"
              id="contact-form"
              name="contact"
              method="POST"
              data-netlify="true"
              aria-label="Contact form"
            >
              <input type="hidden" name="form-name" value="contact" />

              <div class="form-group">
                <label for="contact-name">Your name</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  placeholder="Full name"
                  required
                  autocomplete="name"
                />
              </div>

              <div class="form-group">
                <label for="contact-email">Email address</label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  placeholder="you@example.com"
                  required
                  autocomplete="email"
                />
              </div>

              <div class="form-group">
                <label for="contact-org">Organization (optional)</label>
                <input
                  type="text"
                  id="contact-org"
                  name="organization"
                  placeholder="Company or org name"
                  autocomplete="organization"
                />
              </div>

              <div class="form-group">
                <label for="contact-type">What brings you here?</label>
                <select id="contact-type" name="type" required>
                  <option value="" disabled selected>Select one</option>
                  <option value="community-advisory">Community strategy advisory</option>
                  <option value="ai-governance">AI governance consulting</option>
                  <option value="speaking">Speaking or workshop booking</option>
                  <option value="research">Research collaboration</option>
                  <option value="other">Something else</option>
                </select>
              </div>

              <div class="form-group">
                <label for="contact-message">Tell me about your situation</label>
                <textarea
                  id="contact-message"
                  name="message"
                  placeholder="What problem are you solving? What is the background? What have you already tried?"
                  required
                  rows="6"
                ></textarea>
              </div>

              <div class="form-group">
                <label for="contact-timeline">Timeline</label>
                <select id="contact-timeline" name="timeline">
                  <option value="" disabled selected>When do you need this?</option>
                  <option value="asap">As soon as possible</option>
                  <option value="1-month">Within a month</option>
                  <option value="1-3-months">1 to 3 months</option>
                  <option value="exploring">Just exploring</option>
                </select>
              </div>

              <button type="submit" class="btn btn-primary btn-lg" id="contact-submit" style="width: 100%; justify-content: center;">
                Send message →
              </button>

              <p class="contact__note">I respond to all inquiries within 48 hours.</p>
            </form>
          </div>

          <!-- SIDEBAR -->
          <div class="contact__sidebar">
            <div class="contact__expect card">
              <h3>What to expect</h3>
              <ul class="contact__list">
                <li>
                  <span class="contact__list-icon">⏱</span>
                  <div>
                    <strong>Response time</strong>
                    <p>Within 48 hours on business days</p>
                  </div>
                </li>
                <li>
                  <span class="contact__list-icon">📞</span>
                  <div>
                    <strong>Discovery call</strong>
                    <p>If there is potential fit, we will set up a 30-minute introductory call</p>
                  </div>
                </li>
                <li>
                  <span class="contact__list-icon">🤝</span>
                  <div>
                    <strong>Direct assessment</strong>
                    <p>I will tell you candidly if someone else is better suited for your project</p>
                  </div>
                </li>
              </ul>
            </div>

            <div class="contact__not-fit card">
              <h3>Not a fit if...</h3>
              <ul class="contact__not-fit-list">
                <li>You need routine daily moderation execution rather than strategic architecture and policy design</li>
                <li>You do not have a budget allocated for external advisory work</li>
                <li>You only want confirmation for existing plans rather than objective critique</li>
              </ul>
            </div>

            <div class="contact__connect card">
              <h3>Direct connection</h3>
              <a
                href="https://linkedin.com/in/adrianlee"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline"
                style="width: 100%; justify-content: center;"
                id="contact-linkedin"
              >
                LinkedIn ↗
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
.contact__grid {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: var(--space-10);
  align-items: start;
}
.contact__form { display: flex; flex-direction: column; }
.contact__note { font-size: 0.8125rem; color: var(--text-faint); margin-top: var(--space-4); text-align: center; }

.contact__sidebar { display: flex; flex-direction: column; gap: var(--space-5); }
.contact__expect { padding: var(--space-7); }
.contact__expect h3 { font-size: 1.05rem; margin-bottom: var(--space-5); }
.contact__list { list-style: none; display: flex; flex-direction: column; gap: var(--space-5); }
.contact__list li { display: flex; gap: var(--space-4); align-items: flex-start; }
.contact__list-icon { font-size: 1.25rem; flex-shrink: 0; padding-top: 2px; }
.contact__list strong { display: block; font-size: 0.9rem; margin-bottom: var(--space-1); }
.contact__list p { font-size: 0.875rem; color: var(--text-muted); }

.contact__not-fit { padding: var(--space-7); border-color: var(--border-soft); }
.contact__not-fit h3 { font-size: 1rem; margin-bottom: var(--space-4); }
.contact__not-fit-list { list-style: none; display: flex; flex-direction: column; gap: var(--space-3); }
.contact__not-fit-list li { font-size: 0.875rem; color: var(--text-muted); padding-left: var(--space-5); position: relative; line-height: 1.55; }
.contact__not-fit-list li::before { content: '✗'; position: absolute; left: 0; color: var(--text-faint); font-size: 0.75rem; }

.contact__connect { padding: var(--space-7); }
.contact__connect h3 { font-size: 1rem; margin-bottom: var(--space-4); }

@media (max-width: 900px) {
  .contact__grid { grid-template-columns: 1fr; }
  .contact__sidebar { order: -1; }
}
</style>
